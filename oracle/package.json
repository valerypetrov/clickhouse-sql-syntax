{
  "name": "clickhouse-sql-syntax-oracle",
  "version": "0.0.0",
  "private": true,
  "description": "Compares check() with the real ClickHouse parser on the ClickHouse test corpus",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "corpus": "tsx src/build-corpus.ts",
    "oracle": "tsx src/oracle.ts",
    "oracle:format": "tsx src/format-oracle.ts",
    "oracle:rename": "tsx src/rename-oracle.ts",
    "oracle:arguments": "tsx src/arguments-oracle.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "clickhouse-sql-syntax": "0.2.0"
  }
}
