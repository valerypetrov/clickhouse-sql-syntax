{
  "name": "clickhouse-sql-syntax-monorepo",
  "private": true,
  "description": "Syntax highlighting and syntax checking for ClickHouse SQL",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valerypetrov/clickhouse-sql-syntax.git"
  },
  "workspaces": [
    "packages/core",
    "packages/vscode",
    "oracle"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run build && tsc -p scripts/tsconfig.json && tsx --test \"scripts/test/*.test.ts\" && npm run test --workspaces --if-present",
    "oracle": "npm run oracle -w oracle --",
    "oracle:format": "npm run oracle:format -w oracle --",
    "generate": "tsx scripts/generate-names.ts",
    "package:vscode": "npm run package -w packages/vscode",
    "test:vscode": "npm run test:e2e -w packages/vscode",
    "test:vscode:stress": "npm run test:e2e:stress -w packages/vscode",
    "test:vscode:corpus": "npm run test:e2e:corpus -w packages/vscode"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild": true,
    "@vscode/vsce-sign": true,
    "fsevents": true
  }
}
