{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ClickHouse SQL",
  "scopeName": "source.clickhouse-sql",
  "comment": "Generated by scripts/generate-grammar.ts from clickhouse-sql-syntax. Do not edit.",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#heredoc"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#column-definition"
    },
    {
      "include": "#quoted-identifiers"
    },
    {
      "include": "#query-parameter"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#cast-type"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#words"
    },
    {
      "include": "#illegal"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "include": "#block-comment"
        },
        {
          "name": "comment.line.sql",
          "match": "(?:--|//|#[ !]).*"
        }
      ]
    },
    "block-comment": {
      "name": "comment.block.sql",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        {
          "include": "#block-comment"
        }
      ]
    },
    "heredoc": {
      "name": "string.unquoted.heredoc.sql",
      "begin": "(?<![A-Za-z0-9_$])\\$([A-Za-z0-9_]*)\\$",
      "end": "\\$\\1\\$"
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.sql",
          "match": "(?<![A-Za-z0-9_$])(?:[xX]'[0-9A-Fa-f]*'|[bB]'[01]*')"
        },
        {
          "match": "((?<!['\\\\])'(?>(?:[^'\\\\]|\\\\.|'')*)')([ \\t]+)((?:[A-Za-z0-9_]|\\$(?=[A-Za-z0-9_]))[A-Za-z0-9_$]*)([ \\t]+)((?i:TO))([ \\t]+)((?i:YYYY|MCS|DD|HH|MI|MM|MS|NS|QQ|SS|WK|WW|YY|D|H|M|N|Q|S)(?![A-Za-z0-9_$]))",
          "captures": {
            "1": {
              "name": "string.quoted.single.sql"
            },
            "3": {
              "name": "keyword.other.sql"
            },
            "5": {
              "name": "keyword.other.sql"
            },
            "7": {
              "name": "keyword.other.sql"
            }
          }
        },
        {
          "match": "((?<!['\\\\])'(?>(?:[^'\\\\]|\\\\.|'')*)')([ \\t]+)((?i:YYYY|MCS|DD|HH|MI|MM|MS|NS|QQ|SS|WK|WW|YY|D|H|M|N|Q|S)(?![A-Za-z0-9_$]))",
          "captures": {
            "1": {
              "name": "string.quoted.single.sql"
            },
            "3": {
              "name": "keyword.other.sql"
            }
          }
        },
        {
          "name": "string.quoted.single.sql",
          "begin": "'",
          "end": "'",
          "applyEndPatternLast": 1,
          "patterns": [
            {
              "match": "\\\\.|''"
            }
          ]
        },
        {
          "name": "string.quoted.single.sql",
          "begin": "‘",
          "end": "’"
        }
      ]
    },
    "quoted-identifiers": {
      "patterns": [
        {
          "name": "variable.other.sql",
          "contentName": "meta.quoted-name.sql",
          "begin": "\"",
          "end": "\"",
          "applyEndPatternLast": 1,
          "patterns": [
            {
              "match": "\\\\.|\"\""
            }
          ]
        },
        {
          "name": "variable.other.sql",
          "contentName": "meta.quoted-name.sql",
          "begin": "`",
          "end": "`",
          "applyEndPatternLast": 1,
          "patterns": [
            {
              "match": "\\\\.|``"
            }
          ]
        },
        {
          "name": "variable.other.sql",
          "contentName": "meta.quoted-name.sql",
          "begin": "“",
          "end": "”"
        }
      ]
    },
    "column-definition": {
      "match": "(?:^|(?<=[(,]))[ \\t]*(?!(?i:MATERIALIZED|INTERPOLATE|STATISTICS|ARGUMENTS|EPHEMERAL|INTERSECT|PARTITION|DESCRIBE|DISTINCT|INTERVAL|LIFETIME|PREWHERE|SETTINGS|BETWEEN|COLUMNS|DEFAULT|EXPLAIN|LATERAL|QUALIFY|EXCEPT|FILTER|FORMAT|HAVING|LAYOUT|OFFSET|ROLLUP|SELECT|SOURCE|VALUES|ALIAS|APPLY|CHECK|CODEC|ILIKE|LIMIT|UNION|USING|WHERE|WHERE|CASE|CUBE|ELSE|FROM|JOIN|LIKE|OVER|SETS|SOME|THEN|WHEN|WITH|ALL|AND|NOT|SET|TOP|TTL|AS|BY|IN|ON|OR)(?![A-Za-z0-9_$]))((?![0-9])(?:[A-Za-z0-9_]|\\$(?=[A-Za-z0-9_]))[A-Za-z0-9_$]*|`(?:[^`\\\\]|\\\\.|``)*`|\"(?:[^\"\\\\]|\\\\.|\"\")*\")([ \\t]+)((?:SimpleAggregateFunction|IntervalMicrosecond|IntervalMillisecond|IntervalNanosecond|AggregateFunction|IntervalQuarter|MultiLineString|IntervalMinute|IntervalSecond|LowCardinality|IntervalMonth|IntervalHour|IntervalWeek|IntervalYear|MultiPolygon|FixedString|IntervalDay|LineString|MultiPoint|BFloat16|GEOMETRY|Geometry|Nullable|Dynamic|Float32|Float64|Nothing|Polygon|UInt128|UInt256|Variant|Enum16|Int128|Int256|Nested|String|UInt16|UInt32|UInt64|Array|Enum8|Int16|Int32|Int64|Point|Tuple|UInt8|IPv4|IPv6|Int8|QBit|Ring|UUID|Map|(?i:DateTime32|DateTime64|Decimal128|Decimal256|MEDIUMBLOB|MEDIUMTEXT|CHARACTER|Decimal32|Decimal64|MEDIUMINT|PRECISION|TIMESTAMP|VARBINARY|DateTime|LONGBLOB|LONGTEXT|NATIONAL|NVARCHAR|SMALLINT|TINYBLOB|TINYTEXT|UNSIGNED|VARCHAR2|Decimal|INTEGER|NUMERIC|TINYINT|VARCHAR|VARYING|boolean|BIGINT|BINARY|DOUBLE|Date32|OBJECT|SIGNED|SINGLE|Time64|BYTEA|FIXED|FLOAT|INET4|INET6|LARGE|NCHAR|BLOB|BYTE|Bool|CHAR|CLOB|Date|ENUM|Enum|INT1|JSON|REAL|TEXT|Time|YEAR|bool|BIT|DEC|INT|SET)))(?![A-Za-z0-9_$])",
      "captures": {
        "1": {
          "name": "variable.other.sql",
          "patterns": [
            {
              "include": "#quoted-identifiers"
            }
          ]
        },
        "3": {
          "name": "storage.type.sql"
        }
      }
    },
    "query-parameter": {
      "name": "variable.parameter.sql",
      "match": "\\{\\s*(?![0-9])[A-Za-z0-9_$]+\\s*:\\s*[A-Za-z_$][^{};]*\\}"
    },
    "numbers": {
      "patterns": [
        {
          "match": "((?<=\\.)(?>[0-9](?:_?[0-9])*)(?![A-Za-z0-9_]))(?:([ \\t]+)((?i:YYYY|MCS|DD|HH|MI|MM|MS|NS|QQ|SS|WK|WW|YY|D|H|M|N|Q|S)(?![A-Za-z0-9_$])))?",
          "captures": {
            "1": {
              "name": "constant.numeric.sql"
            },
            "3": {
              "name": "keyword.other.sql"
            }
          }
        },
        {
          "match": "((?<![A-Za-z0-9_$])(?>0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*(?:\\.(?:[0-9A-Fa-f](?:_?[0-9A-Fa-f])*)?)?(?:[pP][+-]?[0-9](?:_?[0-9])*)?|0[bB][01](?:_?[0-9])*(?:\\.(?:[0-9](?:_?[0-9])*)?)?(?:[eE][+-]?[0-9](?:_?[0-9])*)?|[0-9](?:_?[0-9])*(?:\\.(?:[0-9](?:_?[0-9])*)?)?(?:[eE][+-]?[0-9](?:_?[0-9])*)?)(?![A-Za-z0-9_]))(?:([ \\t]+)((?i:YYYY|MCS|DD|HH|MI|MM|MS|NS|QQ|SS|WK|WW|YY|D|H|M|N|Q|S)(?![A-Za-z0-9_$])))?",
          "captures": {
            "1": {
              "name": "constant.numeric.sql"
            },
            "3": {
              "name": "keyword.other.sql"
            }
          }
        },
        {
          "match": "((?<![A-Za-z0-9_$)\\]\"`])(?>\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?)(?![A-Za-z0-9_]))(?:([ \\t]+)((?i:YYYY|MCS|DD|HH|MI|MM|MS|NS|QQ|SS|WK|WW|YY|D|H|M|N|Q|S)(?![A-Za-z0-9_$])))?",
          "captures": {
            "1": {
              "name": "constant.numeric.sql"
            },
            "3": {
              "name": "keyword.other.sql"
            }
          }
        }
      ]
    },
    "cast-type": {
      "patterns": [
        {
          "match": "(::)\\s*((?:SimpleAggregateFunction|IntervalMicrosecond|IntervalMillisecond|IntervalNanosecond|AggregateFunction|IntervalQuarter|MultiLineString|IntervalMinute|IntervalSecond|LowCardinality|IntervalMonth|IntervalHour|IntervalWeek|IntervalYear|MultiPolygon|FixedString|IntervalDay|LineString|MultiPoint|BFloat16|GEOMETRY|Geometry|Nullable|Dynamic|Float32|Float64|Nothing|Polygon|UInt128|UInt256|Variant|Enum16|Int128|Int256|Nested|String|UInt16|UInt32|UInt64|Array|Enum8|Int16|Int32|Int64|Point|Tuple|UInt8|IPv4|IPv6|Int8|QBit|Ring|UUID|Map|(?i:DateTime32|DateTime64|Decimal128|Decimal256|MEDIUMBLOB|MEDIUMTEXT|CHARACTER|Decimal32|Decimal64|MEDIUMINT|PRECISION|TIMESTAMP|VARBINARY|DateTime|LONGBLOB|LONGTEXT|NATIONAL|NVARCHAR|SMALLINT|TINYBLOB|TINYTEXT|UNSIGNED|VARCHAR2|Decimal|INTEGER|NUMERIC|TINYINT|VARCHAR|VARYING|boolean|BIGINT|BINARY|DOUBLE|Date32|OBJECT|SIGNED|SINGLE|Time64|BYTEA|FIXED|FLOAT|INET4|INET6|LARGE|NCHAR|BLOB|BYTE|Bool|CHAR|CLOB|Date|ENUM|Enum|INT1|JSON|REAL|TEXT|Time|YEAR|bool|BIT|DEC|INT|SET)))(?![A-Za-z0-9_$])",
          "captures": {
            "1": {
              "name": "keyword.operator.sql"
            },
            "2": {
              "name": "storage.type.sql"
            }
          }
        },
        {
          "match": "(?<![A-Za-z0-9_$])((?i:AS))([ \\t]+)((?:SimpleAggregateFunction|IntervalMicrosecond|IntervalMillisecond|IntervalNanosecond|AggregateFunction|IntervalQuarter|MultiLineString|IntervalMinute|IntervalSecond|LowCardinality|IntervalMonth|IntervalHour|IntervalWeek|IntervalYear|MultiPolygon|FixedString|IntervalDay|LineString|MultiPoint|BFloat16|GEOMETRY|Geometry|Nullable|Dynamic|Float32|Float64|Nothing|Polygon|UInt128|UInt256|Variant|Enum16|Int128|Int256|Nested|String|UInt16|UInt32|UInt64|Array|Enum8|Int16|Int32|Int64|Point|Tuple|UInt8|IPv4|IPv6|Int8|QBit|Ring|UUID|Map|(?i:DateTime32|DateTime64|Decimal128|Decimal256|MEDIUMBLOB|MEDIUMTEXT|CHARACTER|Decimal32|Decimal64|MEDIUMINT|PRECISION|TIMESTAMP|VARBINARY|DateTime|LONGBLOB|LONGTEXT|NATIONAL|NVARCHAR|SMALLINT|TINYBLOB|TINYTEXT|UNSIGNED|VARCHAR2|Decimal|INTEGER|NUMERIC|TINYINT|VARCHAR|VARYING|boolean|BIGINT|BINARY|DOUBLE|Date32|OBJECT|SIGNED|SINGLE|Time64|BYTEA|FIXED|FLOAT|INET4|INET6|LARGE|NCHAR|BLOB|BYTE|Bool|CHAR|CLOB|Date|ENUM|Enum|INT1|JSON|REAL|TEXT|Time|YEAR|bool|BIT|DEC|INT|SET)))(?![A-Za-z0-9_$])(?=[ \\t]*[()])",
          "captures": {
            "1": {
              "name": "keyword.other.sql"
            },
            "3": {
              "name": "storage.type.sql"
            }
          }
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.sql",
      "match": "<=>|!~\\*|::|->|<=|>=|<>|!=|==|\\|\\||\\|>|~\\*|!~|@@|[-+*/%=<>?:^~|@\\x{2212}]|\\$(?![A-Za-z0-9_])"
    },
    "punctuation": {
      "name": "punctuation.sql",
      "match": "[()\\[\\]{},.;]|\\\\[G]"
    },
    "words": {
      "patterns": [
        {
          "name": "variable.other.sql",
          "match": "(?<=\\.)(?:[A-Za-z0-9_]|\\$(?=[A-Za-z0-9_]))[A-Za-z0-9_$]*|(?<![A-Za-z0-9_$])(?:[A-Za-z0-9_]|\\$(?=[A-Za-z0-9_]))[A-Za-z0-9_$]*(?=\\s*\\.(?![0-9]))"
        },
        {
          "match": "(?<![A-Za-z0-9_$])((?i:FORMAT))([ \\t]+)((?:[A-Za-z0-9_]|\\$(?=[A-Za-z0-9_]))[A-Za-z0-9_$]*)",
          "captures": {
            "1": {
              "name": "keyword.other.sql"
            },
            "3": {
              "name": "variable.other.sql"
            }
          }
        },
        {
          "name": "constant.language.sql",
          "match": "(?<![A-Za-z0-9_$])(?i:FALSE|NULL|TRUE)(?![A-Za-z0-9_$])"
