          "captures": {
            "1": {
              "name": "keyword.other.sql"
            },
            "3": {
              "name": "variable.other.sql"
            }
          }
        },
        {
          "match": "(?<![A-Za-z0-9_$])((?i:ENGINE))([ \\t]*)(=)([ \\t]*)((?:[A-Za-z0-9_]|\\$(?=[A-Za-z0-9_]))[A-Za-z0-9_$]*)(?=[ \\t]*\\()",
          "captures": {
            "1": {
              "name": "keyword.other.sql"
            },
            "3": {
              "name": "keyword.operator.sql"
            },
            "5": {
              "name": "entity.name.function.sql"
            }
          }
        },
        {
          "match": "(?<![A-Za-z0-9_$])((?i:ENGINE))([ \\t]*)(=)([ \\t]*)((?:[A-Za-z0-9_]|\\$(?=[A-Za-z0-9_]))[A-Za-z0-9_$]*)(?![A-Za-z0-9_$])",
          "captures": {
            "1": {
              "name": "keyword.other.sql"
            },
            "3": {
              "name": "keyword.operator.sql"
            },
            "5": {
              "name": "variable.other.sql"
            }
          }
        },
        {
          "name": "storage.type.sql",
          "match": "(?<![A-Za-z0-9_$])(?:SimpleAggregateFunction|IntervalMicrosecond|IntervalMillisecond|IntervalNanosecond|AggregateFunction|IntervalQuarter|MultiLineString|IntervalMinute|IntervalSecond|LowCardinality|IntervalMonth|IntervalHour|IntervalWeek|IntervalYear|MultiPolygon|FixedString|IntervalDay|DateTime32|DateTime64|Decimal128|Decimal256|LineString|MEDIUMBLOB|MEDIUMTEXT|MultiPoint|Decimal32|Decimal64|MEDIUMINT|VARBINARY|BFloat16|DateTime|GEOMETRY|Geometry|LONGBLOB|LONGTEXT|NATIONAL|NVARCHAR|Nullable|SMALLINT|TINYBLOB|TINYTEXT|VARCHAR2|Decimal|Dynamic|Float32|Float64|INTEGER|NUMERIC|Nothing|Polygon|TINYINT|UInt128|UInt256|VARCHAR|Variant|boolean|BIGINT|BINARY|DOUBLE|Date32|Enum16|Int128|Int256|Nested|SINGLE|String|Time64|UInt16|UInt32|UInt64|Array|BYTEA|Enum8|FIXED|FLOAT|INET4|INET6|Int16|Int32|Int64|NCHAR|Point|Tuple|UInt8|BLOB|BYTE|Bool|CLOB|Date|Enum|INT1|IPv4|IPv6|Int8|JSON|QBit|REAL|Ring|TEXT|Time|bool|BIT|DEC|INT|Map)(?![A-Za-z0-9_$])"
        },
        {
          "match": "(?<![A-Za-z0-9_$])((?i:COLUMN))([ \\t]+)((?:[A-Za-z0-9_]|\\$(?=[A-Za-z0-9_]))[A-Za-z0-9_$]*)([ \\t]+)((?:SimpleAggregateFunction|IntervalMicrosecond|IntervalMillisecond|IntervalNanosecond|AggregateFunction|IntervalQuarter|MultiLineString|IntervalMinute|IntervalSecond|LowCardinality|IntervalMonth|IntervalHour|IntervalWeek|IntervalYear|MultiPolygon|FixedString|IntervalDay|LineString|MultiPoint|BFloat16|GEOMETRY|Geometry|Nullable|Dynamic|Float32|Float64|Nothing|Polygon|UInt128|UInt256|Variant|Enum16|Int128|Int256|Nested|String|UInt16|UInt32|UInt64|Array|Enum8|Int16|Int32|Int64|Point|Tuple|UInt8|IPv4|IPv6|Int8|QBit|Ring|UUID|Map|(?i:DateTime32|DateTime64|Decimal128|Decimal256|MEDIUMBLOB|MEDIUMTEXT|CHARACTER|Decimal32|Decimal64|MEDIUMINT|PRECISION|TIMESTAMP|VARBINARY|DateTime|LONGBLOB|LONGTEXT|NATIONAL|NVARCHAR|SMALLINT|TINYBLOB|TINYTEXT|UNSIGNED|VARCHAR2|Decimal|INTEGER|NUMERIC|TINYINT|VARCHAR|VARYING|boolean|BIGINT|BINARY|DOUBLE|Date32|OBJECT|SIGNED|SINGLE|Time64|BYTEA|FIXED|FLOAT|INET4|INET6|LARGE|NCHAR|BLOB|BYTE|Bool|CHAR|CLOB|Date|ENUM|Enum|INT1|JSON|REAL|TEXT|Time|YEAR|bool|BIT|DEC|INT|SET)))(?![A-Za-z0-9_$])",
          "captures": {
            "1": {
              "name": "keyword.other.sql"
            },
            "3": {
              "name": "variable.other.sql"
            },
            "5": {
              "name": "storage.type.sql"
            }
          }
        },
        {
          "match": "(?<![A-Za-z0-9_$])((?i:DICTIONARY|PROJECTION|CLUSTER|EXISTS|INDEX|TABLE|INTO|VIEW|TO))(\\s+)(?!(?i:MATERIALIZED|INTERPOLATE|STATISTICS|ARGUMENTS|EPHEMERAL|INTERSECT|PARTITION|DESCRIBE|DISTINCT|INTERVAL|LIFETIME|PREWHERE|SETTINGS|BETWEEN|COLUMNS|DEFAULT|EXPLAIN|LATERAL|QUALIFY|EXCEPT|FILTER|HAVING|LAYOUT|OFFSET|ROLLUP|SELECT|SOURCE|VALUES|ALIAS|APPLY|CHECK|CODEC|ILIKE|LIMIT|UNION|USING|WHERE|CASE|CUBE|ELSE|FROM|JOIN|LIKE|OVER|SETS|SOME|THEN|WHEN|WITH|ALL|AND|KEY|NOT|TOP|TTL|AS|BY|IN|ON|OR)(?![A-Za-z0-9_$]))((?:[A-Za-z0-9_]|\\$(?=[A-Za-z0-9_]))[A-Za-z0-9_$]*)(?=[ \\t]*\\()",
          "captures": {
